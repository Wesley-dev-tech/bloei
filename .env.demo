# De demoversie van Bloei (BESLISSING 364). Vite leest dit bestand alleen met --mode demo (npm run dev:demo, build:demo,
# preview:demo). Er staat geen geheim in: het hoort in de repo. Zie .env.example voor alle variabelen.
VITE_DEMO=true
# De demo verbindt nooit met een meldingsdienst: deze twee blijven leeg, ook als .env ze voor de echte versie invult.
# (vite.config.js en src/meldingen/config.js maken ze in de demo bovendien altijd leeg.)
VITE_PUSH_URL=
VITE_VAPID_PUBLIEK=
